#!/bin/sh
# Run by git when core.hooksPath = .githooks (see AGENTS.md). Two jobs, kept cheap:
#  1. the generated docs index must match the files on disk — a stale catalogue is worse than none;
#  2. a staged .ts/.tsx file must still typecheck — 10 s, skipped when no code is staged, because a broken
#     merge is what reaches the live plugin, not a broken markdown file.
set -e
root="$(git rev-parse --show-toplevel)"

if ! node --experimental-strip-types "$root/_tools/docs-index.ts" --check >/dev/null 2>&1; then
  echo "docs/_index.md is stale — run: npm run docs:index" >&2
  exit 1
fi

if git diff --cached --name-only | grep -qE '\.(ts|tsx)$'; then
  if ! (cd "$root" && npx tsc --noEmit); then
    echo "typecheck failed — fix the types before committing" >&2
    exit 1
  fi
fi
